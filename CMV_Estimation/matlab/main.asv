% main.m – Cloud Motion Vector Estimation
% Defines all global configurations, loads images, then calls stage-specific scripts
close all;

%% Add Paths
addpath(genpath('matlab'));
addpath(genpath('python'));
addpath(genpath('results'));
addpath(genpath('data'));
addpath(genpath('results'));
addpath(genpath('python_scripts'));
addpath(genpath('checkpoints'));

% Configure Python Environment & simple startup
% config.pythonExe = '.\python\python\Scripts\python.exe';  % Path to python.exe
dummy = py.list();
%% Configuration

% Directories
config.dataRawDir = '.\data\Images\EvaluationSet';
config.createSynthImages = '.\data\Images\CreateSyntheticImages';
config.dataConfigDir = '.\data\config';
config.dataProcessedDir = '.\data\processed';
config.resultsDir = '.\results';
config.synthImageDirectory = '.\data\Images\SyntheticImages';

% Lucas-Kanade parameters
config.lkNoiseThreshold = 0.0039;
config.lkPyramidLevels = 3;

% Farnebäck parameters
config.fbWindowSize = 7;
config.fbPyramidLevels = 4;

% Create directories
if ~exist(config.dataConfigDir, 'dir')
    mkdir(config.dataConfigDir);
end
if ~exist(config.resultsDir, 'dir')
    mkdir(config.resultsDir);
end
if ~exist(config.dataProcessedDir, 'dir')
    mkdir(config.dataProcessedDir);
end
if ~exist(config.synthImageDirectory, 'dir')
    mkdir(config.synthImageDirectory);
end
if ~exist(config.createSynthImages, 'dir')
    mkdir(config.createSynthImages);
end


filename = 'config.mat';
prep_file = fullfile(config.dataConfigDir, filename);
save(prep_file, '-struct', 'config');

createSynFiles = dir(fullfile(config.createSynthImages, '*.jpg'));
config.numberCreateSynImages = numel(createSynFiles); 

% Images
files  = dir(fullfile(config.dataRawDir, '*.jpg'));
config.numberImages = numel(files);

synFiles = dir(fullfile(config.synthImageDirectory, '*.jpg'));
config.numberSynthImages = numel(synFiles);

%% Main-Loop
% pyrunfile("./python_scripts/raft_inference.py '--checkpoints' 'checkpoints/raft_finetune_300_best_metric.pth'");
% timing_results_300 = pyrunfile("./python_scripts/raft_inference.py '--checkpoints' 'checkpoints/raft_finetune_300.pth'", "timing_results");
% 
% pyrunfile("./python_scripts/raft_inference.py '--checkpoints' 'checkpoints/raft_finetune_600_best_metric.pth'");
% timing_results_600 = pyrunfile("./python_scripts/raft_inference.py '--checkpoints' 'checkpoints/raft_finetune_600.pth'", "timing_results");
% 
% pyrunfile("./python_scripts/raft_inference.py '--checkpoints' 'checkpoints/raft_finetune_900_best_metric.pth'");
% timing_results_900 = pyrunfile("./python_scripts/raft_inference.py '--checkpoints' 'checkpoints/raft_finetune_900.pth'", "timing_results");
% 
% timing_results_2000 = pyrunfile("./python_scripts/raft_inference.py '--checkpoints' 'checkpoints/raft_finetune_2000.pth'", "timing_results");
% pyrunfile("./python_scripts/raft_inference.py '--checkpoints' 'checkpoints/raft_finetune_2000_best_metric.pth'");


for idxPair = 1:2:config.numberImages
    % Load Images

    timestamp = regexp(files(idxPair).name, '(\d{14})', 'tokens', 'once');

    img1Path = fullfile(config.dataRawDir, files(idxPair).name);
    img2Path = fullfile(config.dataRawDir, files(idxPair+1).name);

    try
        img1 = imread(img1Path);
        img2 = imread(img2Path);
    catch ME
        error('Failed to load images: %s', ME.message);
    end

    % RUN STAGES
    % Stage 1: Preprocessing
    run('stage_01_preprocessing.m');

    % % %Stage 2: Lucas-Kanade
    run('stage_02_lucas_kanade.m');

    % % %Stage 3: Farnebäck
    run('stage_03_farnebaeck.m');

    % % %Stage 4: RAFT
    run('stage_04_raft.m');

    % %Stage 5: Visualization
    % run('stage_05_visualization.m');

    % % Stage 6: Evaluation (optional)
    run('stage_06_evaluation.m');
end

%% synthetic evaluation
for translationIdx = 1:3
    
    syntheticTranslation = [5 -1; -5 9; 10 12];
    syntheticTranslationMag = sqrt(syntheticTranslation(translationIdx,1).^2 + syntheticTranslation(translationIdx,2).^2); 
    syntheticTranslationAngle = atan2(syntheticTranslation(translationIdx,2), syntheticTranslation(translationIdx,1)) * 180/pi;
    
    syntheticImageSize = [512 512]; % [H W]
    
    create_synthetic_images(createSynFiles, syntheticTranslation(translationIdx,:), config)
    flowSynGt = synthetic_flow(syntheticImageSize, syntheticTranslation(translationIdx,:));
    
    pause(5)
    % 
    % syn_timing_results_300 = pyrunfile("./python_scripts/raft_inference.py '--checkpoints' 'checkpoints/raft_finetune_300.pth' '--images' 'data/Images/SyntheticImages'", "timing_results");
    % 
    % syn_timing_results_600 = pyrunfile("./python_scripts/raft_inference.py '--checkpoints' 'checkpoints/raft_finetune_600.pth' '--images' 'data/Images/SyntheticImages'", "timing_results");
    % 
    % syn_timing_results_900 = pyrunfile("./python_scripts/raft_inference.py '--checkpoints' 'checkpoints/raft_finetune_900.pth' '--images' 'data/Images/SyntheticImages'", "timing_results");
    % 
    % syn_timing_results_2000 = pyrunfile("./python_scripts/raft_inference.py '--checkpoints' 'checkpoints/raft_finetune_2000.pth' '--images' 'data/Images/SyntheticImages'", "timing_results");
    
    % pyrunfile("./python_scripts/raft_inference.py '--checkpoints' 'checkpoints/raft_kubric.pth' '--images' 'data/Images/SyntheticImages'");
    synMetrics = struct();
    
    synMetrics.RAFT_300.syn_timing_results = struct(syn_timing_results_300);
    synMetrics.RAFT_600.syn_timing_results = struct(syn_timing_results_600);
    synMetrics.RAFT_900.syn_timing_results = struct(syn_timing_results_900);
    synMetrics.RAFT_2000.syn_timing_results = struct(syn_timing_results_2000);
    
    synMetrics.RAFT_300.runtime = synMetrics.RAFT_300.syn_timing_results.mean_time_per_pair;
    synMetrics.RAFT_600.runtime = synMetrics.RAFT_600.syn_timing_results.mean_time_per_pair;
    synMetrics.RAFT_900.runtime = synMetrics.RAFT_900.syn_timing_results.mean_time_per_pair;
    synMetrics.RAFT_2000.runtime = synMetrics.RAFT_2000.syn_timing_results.mean_time_per_pair;
    
    fprintf('current Translation Magnitude: %.3f \n', syntheticTranslationMag)
    fprintf('current Translation Angle: %.3f deg %.3f rad\n', syntheticTranslationAngle, syntheticTranslationAngle/180*pi)

    for idxPair = 1:2:config.numberSynthImages
        % Load Images
        idx = (idxPair+1)/2;
        timestamp = regexp(synFiles(idxPair).name, '(\d{14})', 'tokens', 'once');
        
        img1Path = fullfile(config.synthImageDirectory, synFiles(idxPair).name);
        img2Path = fullfile(config.synthImageDirectory, synFiles(idxPair+1).name);
        
        try
            img1 = imread(img1Path);
            img2 = imread(img2Path);
        catch ME
            error('Failed to load images: %s', ME.message);
        end
    
        % Stage 1: Preprocessing
        run('stage_01_preprocessing.m');
    
        % Stage 6: Evaluation (optional)
        run('stage_06_synthetic_evaluation.m');
    end
end